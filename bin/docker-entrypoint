#!/bin/bash
set -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit 2>/dev/null || true)
    if [ -n "$LD_PRELOAD" ]; then
        export LD_PRELOAD
    fi
fi

# Remove stale server.pid if it exists
if [ -f /rails/tmp/pids/server.pid ]; then
  rm -f /rails/tmp/pids/server.pid
fi

if [[ "$*" == *"rails server"* ]] || [[ "$*" == *"thrust"* ]]; then
  echo "=> Running database preparation (db:prepare)..."
  ./bin/rails db:prepare
fi

exec "${@}"
