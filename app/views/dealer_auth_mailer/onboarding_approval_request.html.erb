<%= mailer_banner(title: "New Dealer Approval Required", subtitle: "SalesPoints Dealer Onboarding", badge: "Action Required", theme: :warning) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    A new dealer registration has been submitted and is awaiting your approval.
  </p>

  <%= mailer_info_table([
    ["Dealer Name", @dealer.full_name],
    ["Email", @dealer.email],
    ["Phone", @dealer.phone],
    ["Business Name", @dealer.dealer_profile&.business_name.presence || "-"],
    ["Business Type", @dealer.dealer_profile&.business_type.presence || "-"],
    ["Work Category", @dealer.dealer_profile&.work_category.presence || "-"],
    ["GST Number", @dealer.dealer_profile&.gst_number.presence || "-"],
    ["PAN Number", @dealer.dealer_profile&.pan_number.presence || "-"],
    ["Status", @dealer.status.to_s.humanize],
    ["Registered On", @dealer.created_at.strftime("%d %B %Y, %I:%M %p")]
  ]) %>

  <%= mailer_notice("Please review the dealer information and approve or reject the registration from the Admin Panel.", theme: :info) %>

  <%= mailer_button(url: @reviewer_portal_url, text: "Open Admin Panel", theme: :warning) %>
<%= mailer_body_close %>
