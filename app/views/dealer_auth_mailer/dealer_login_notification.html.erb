<%= mailer_banner(title: "Dealer Login Notification", subtitle: "SalesPoints Dealer Security", badge: "Security Alert", theme: :info) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">
    Hi <%= @dealer.full_name %>,
  </p>

  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    Your SalesPoints Dealer account was successfully logged in. Here are the details:
  </p>

  <%= mailer_info_table([
    ["Login Time", @login_time],
    ["Dealer Email", @dealer.email],
    ["Business Name", @dealer.dealer_profile&.business_name || 'N/A']
  ]) %>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #fffbeb; border-left: 4px solid #f59e0b; border-radius: 6px; margin: 20px 0;">
    <tr>
      <td style="padding: 14px 18px; font-size: 13px; color: #92400e; line-height: 1.7;">
        <strong>Security Tips</strong><br>
        &#10003; Always ensure you're on the secure dealer portal<br>
        &#10003; Never share your credentials with anyone<br>
        &#10003; Log out when leaving your workstation<br>
        &#10003; Use a strong, unique password
      </td>
    </tr>
  </table>

  <%= mailer_notice("If you didn't authorize this login, please <a href=\"#{ENV['DEALER_LOGIN_URL'] || 'http://salespoints.in/dealer/reset-password'}\" style=\"color: #991b1b; font-weight: 700;\">reset your password immediately</a>.".html_safe, theme: :danger, title: "Didn't recognize this login?") %>
<%= mailer_body_close %>
