<% dealer_name = @dealer.try(:full_name).presence || "#{@dealer.try(:first_name)} #{@dealer.try(:last_name)}".strip.presence || "Partner" %>

<!-- Header Banner -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%); background-color: #0f172a; padding: 36px 28px; text-align: center;">
  <tr>
    <td align="center">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 12px;">
        <tr>
          <td style="background-color: rgba(59, 130, 246, 0.2); border: 1px solid #3b82f6; border-radius: 20px; padding: 4px 14px; font-size: 11px; font-weight: 700; color: #93c5fd; text-transform: uppercase; letter-spacing: 1px;">
            Partner Onboarding
          </td>
        </tr>
      </table>
      <h1 style="margin: 0; font-size: 24px; font-weight: 800; color: #ffffff; letter-spacing: -0.5px; line-height: 1.3;">
        Verify Your Dealer Account
      </h1>
      <p style="margin: 8px 0 0 0; font-size: 14px; color: #cbd5e1; line-height: 1.5;">
        SalesPoints Marketplace Dealer Registration
      </p>
    </td>
  </tr>
</table>

<!-- Main Content Area -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="padding: 32px 28px; background-color: #ffffff;">
  <tr>
    <td>
      <p style="margin: 0 0 14px 0; font-size: 16px; font-weight: 600; color: #0f172a;">
        Hello <%= dealer_name %>,
      </p>

      <p style="margin: 0 0 24px 0; font-size: 14px; line-height: 1.6; color: #334155;">
        Thank you for choosing to partner with SalesPoints. Please use the 6-digit One-Time Password (OTP) below to verify your email address and proceed with onboarding.
      </p>

      <!-- OTP Box -->
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f0fdf4; border: 2px dashed #86efac; border-radius: 12px; margin: 20px 0;">
        <tr>
          <td align="center" style="padding: 24px 16px;">
            <p style="margin: 0 0 6px 0; font-size: 11px; font-weight: 700; color: #166534; text-transform: uppercase; letter-spacing: 1px;">
              Your 6-Digit Verification Code
            </p>
            <div style="font-size: 36px; font-weight: 800; color: #15803d; letter-spacing: 8px; font-family: 'Courier New', Courier, monospace; margin: 10px 0;">
              <%= @otp %>
            </div>
            <p style="margin: 8px 0 0 0; font-size: 12px; color: #4ade80; font-weight: 600;">
              &#9202; Valid for <%= @expires_in_minutes || 10 %> minutes
            </p>
          </td>
        </tr>
      </table>

      <!-- One-click Verify Button -->
      <% if @verify_url.present? %>
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 28px 0 20px 0;">
        <tr>
          <td align="center">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td align="center" style="background-color: #1d4ed8; border-radius: 10px; box-shadow: 0 4px 12px rgba(29, 78, 216, 0.25);">
                  <a href="<%= @verify_url %>" target="_blank" style="display: inline-block; padding: 14px 32px; font-size: 15px; font-weight: 700; color: #ffffff; text-decoration: none; border-radius: 10px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
                    Verify Account Online &rarr;
                  </a>
                </td>
              </tr>
            </table>
          </td>
        </tr>
      </table>
      <% end %>

      <!-- Agreement Attached Notice Box -->
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #eff6ff; border: 1px solid #bfdbfe; border-radius: 10px; margin: 24px 0;">
        <tr>
          <td style="padding: 16px 20px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td valign="top" width="28" style="font-size: 18px;">
                  &#128196;
                </td>
                <td style="font-size: 13px; color: #1e40af; line-height: 1.5;">
                  <strong style="color: #1e3a8a;">Official Dealer Agreement Attached</strong><br>
                  We have attached your <strong>SalesPoints Dealer Terms &amp; Conditions Agreement PDF (SalesPoints_Dealer_Agreement.pdf)</strong> to this email. Please review it for your records and compliance.
                </td>
              </tr>
            </table>
          </td>
        </tr>
      </table>

      <!-- Security Guidance -->
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; margin: 20px 0;">
        <tr>
          <td style="padding: 14px 18px; font-size: 12px; color: #64748b; line-height: 1.6;">
            <strong style="color: #334155;">Security Notice:</strong> Never share this OTP with anyone, including SalesPoints staff. If you did not initiate this request, please contact <a href="mailto:support@salespoints.in" style="color: #2563eb;">support@salespoints.in</a> immediately.
          </td>
        </tr>
      </table>

      <p style="margin: 20px 0 0 0; font-size: 13px; line-height: 1.6; color: #475569;">
        Best regards,<br>
        <strong style="color: #0f172a;">SalesPoints Dealer Operations Team</strong>
      </p>
    </td>
  </tr>
</table>
