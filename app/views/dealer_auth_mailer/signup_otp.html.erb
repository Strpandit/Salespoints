<% dealer_name = @dealer.try(:full_name).presence || "#{@dealer.try(:first_name)} #{@dealer.try(:last_name)}".strip.presence || "Partner" %>
<%= mailer_banner(title: "Verify Your Dealer Account", subtitle: "SalesPoints Marketplace Dealer Registration", badge: "Partner Onboarding", theme: :info) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">
    Hello <%= dealer_name %>,
  </p>

  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    Thank you for choosing to partner with SalesPoints. Please use the 6-digit One-Time Password (OTP) below to verify your email address and proceed with onboarding.
  </p>

  <%= mailer_otp_box(code: @otp, label: "Your 6-Digit Verification Code", expires_in: "#{@expires_in_minutes || 10} minutes", theme: :success) %>

  <% if @verify_url.present? %>
    <%= mailer_button(url: @verify_url, text: "Verify Account Online →", theme: :info) %>
  <% end %>

  <%= mailer_notice("We have attached your <strong>SalesPoints Dealer Terms &amp; Conditions Agreement PDF (SalesPoints_Dealer_Agreement.pdf)</strong> to this email. Please review it for your records and compliance.".html_safe, theme: :info, title: "Official Dealer Agreement Attached:") %>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; margin: 20px 0;">
    <tr>
      <td style="padding: 14px 18px; font-size: 12px; color: #64748b; line-height: 1.6;">
        <strong style="color: #334155;">Security Notice:</strong> Never share this OTP with anyone, including SalesPoints staff. If you did not initiate this request, please contact <a href="mailto:support@salespoints.in" style="color: #2563eb;">support@salespoints.in</a> immediately.
      </td>
    </tr>
  </table>

  <p style="margin: 0; font-size: 13px; line-height: 1.6; color: #475569;">
    Best regards,<br>
    <strong style="color: #0f172a;">SalesPoints Dealer Operations Team</strong>
  </p>
<%= mailer_body_close %>
