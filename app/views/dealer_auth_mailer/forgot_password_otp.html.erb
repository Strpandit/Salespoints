<% dealer_name = @dealer.try(:full_name).presence || "#{@dealer.try(:first_name)} #{@dealer.try(:last_name)}".strip.presence || "Dealer" %>
<%= mailer_banner(title: "Password Reset Request", subtitle: "SalesPoints Dealer Security Verification", badge: "Security Notification", theme: :danger) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">
    Hello <%= dealer_name %>,
  </p>

  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    We received a request to reset your SalesPoints dealer account password. Please use the following 6-digit OTP to proceed:
  </p>

  <%= mailer_otp_box(code: @otp, label: "Password Reset Code", expires_in: "#{@expires_in_minutes || 10} minutes", theme: :danger) %>

  <%= mailer_notice("If you did not request this password reset, please ignore this email or reach out to <a href=\"mailto:support@salespoints.in\" style=\"color: #991b1b; font-weight: 700;\">support@salespoints.in</a> immediately. Your account remains secure.".html_safe, theme: :danger, title: "Important Security Notice:") %>

  <p style="margin: 24px 0 0 0; font-size: 13px; line-height: 1.6; color: #475569;">
    Best regards,<br>
    <strong style="color: #0f172a;">SalesPoints Security Team</strong>
  </p>
<%= mailer_body_close %>
