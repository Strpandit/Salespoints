<%= mailer_banner(title: "Password Reset Confirmed", subtitle: "SalesPoints Admin System", badge: "✓ Confirmed", theme: :success) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">
    Hello <%= @admin.full_name %>,
  </p>

  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    Your password has been successfully reset. You can now use your new password to log in to your admin account.
  </p>

  <%= mailer_info_table([
    ["Password Reset Date & Time", @reset_time],
    ["Admin Email", @admin.email]
  ]) %>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #fffbeb; border-left: 4px solid #f59e0b; border-radius: 6px; margin: 20px 0;">
    <tr>
      <td style="padding: 14px 18px; font-size: 13px; color: #92400e; line-height: 1.7;">
        <strong>Next Steps</strong><br>
        1. Use your new password to log in to the admin portal<br>
        2. Consider updating your password policy<br>
        3. Enable two-factor authentication for better security
      </td>
    </tr>
  </table>

  <%= mailer_notice("If you did not request this password reset, please contact IT support immediately.", theme: :danger, title: "Didn't request this?") %>
<%= mailer_body_close %>
