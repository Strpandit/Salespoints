<%= mailer_banner(title: "Admin Login OTP", subtitle: "SalesPoints Admin System", badge: "Security Verification", theme: :info) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">
    Hello <%= @admin.full_name %>,
  </p>

  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    We received a request to verify your profile. Please use the OTP below to complete the verification process.
  </p>

  <%= mailer_otp_box(code: @otp, label: "Your OTP", expires_in: "#{@expires_in_minutes} minutes", theme: :info) %>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; margin: 20px 0;">
    <tr>
      <td style="padding: 14px 18px; font-size: 12px; color: #64748b; line-height: 1.7;">
        Use this OTP only on the official admin portal.<br>
        Never share it over chat or call.<br>
        If you did not request this, contact the support team immediately.
      </td>
    </tr>
  </table>
<%= mailer_body_close %>
