<%= mailer_banner(title: "New Admin Approval Required", subtitle: "SalesPoints Admin Onboarding", badge: "Action Required", theme: :warning) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    A new admin onboarding form has been submitted and is awaiting approval.
  </p>

  <%= mailer_info_table([
    ["Name", @admin.full_name],
    ["Email", @admin.email],
    ["Phone", @admin.phone],
    ["Assigned Roles", @admin.roles.active.pluck(:name).join(", ").presence || "No role assigned"],
    ["Approval Status", @admin.approval_status.to_s.humanize]
  ]) %>

  <%= mailer_notice("Offer letter PDF with submitted joining details is attached for your review.", theme: :info) %>

  <%= mailer_button(url: @reviewer_portal_url, text: "Open Admin Panel", theme: :warning) %>
<%= mailer_body_close %>
