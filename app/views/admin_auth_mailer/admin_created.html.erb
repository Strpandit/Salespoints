<%= mailer_banner(title: "Admin Account Created", subtitle: "SalesPoints Admin System", badge: "Account Created", theme: :purple) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">
    Hello <%= @admin.full_name %>,
  </p>

  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    Your SalesPoints Admin account has been successfully created. Below are your login credentials:
  </p>

  <%= mailer_info_table([
    ["Email", @admin.email],
    ["Temporary Password", @password],
    ["Admin Portal", @login_url]
  ]) %>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #fffbeb; border-left: 4px solid #f59e0b; border-radius: 6px; margin: 20px 0;">
    <tr>
      <td style="padding: 14px 18px; font-size: 13px; color: #92400e; line-height: 1.7;">
        <strong>Security Notice</strong><br>
        &bull; Keep your credentials confidential and secure<br>
        &bull; Change your password immediately upon first login<br>
        &bull; Never share your password via email or chat<br>
        &bull; Enable two-factor authentication for added security
      </td>
    </tr>
  </table>

  <p style="margin: 0 0 12px 0; font-size: 15px; font-weight: 700; color: #0f172a;">Getting Started</p>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 8px;">
    <tr>
      <td valign="top" width="28" style="padding: 6px 0; font-size: 13px; font-weight: 700; color: #7e22ce;">1.</td>
      <td style="padding: 6px 0; font-size: 13px; color: #334155;"><strong>Log in</strong> with your credentials</td>
    </tr>
    <tr>
      <td valign="top" width="28" style="padding: 6px 0; font-size: 13px; font-weight: 700; color: #7e22ce;">2.</td>
      <td style="padding: 6px 0; font-size: 13px; color: #334155;"><strong>Change your password</strong> to something secure</td>
    </tr>
    <tr>
      <td valign="top" width="28" style="padding: 6px 0; font-size: 13px; font-weight: 700; color: #7e22ce;">3.</td>
      <td style="padding: 6px 0; font-size: 13px; color: #334155;"><strong>Set up 2FA</strong> for enhanced security</td>
    </tr>
    <tr>
      <td valign="top" width="28" style="padding: 6px 0; font-size: 13px; font-weight: 700; color: #7e22ce;">4.</td>
      <td style="padding: 6px 0; font-size: 13px; color: #334155;"><strong>Review your permissions</strong> and modules</td>
    </tr>
  </table>

  <%= mailer_button(url: @login_url, text: "Go to Admin Portal", theme: :purple) %>

  <p style="margin: 0; font-size: 13px; line-height: 1.6; color: #475569;">
    If you have any questions or need assistance, please contact the IT support team.
  </p>
<%= mailer_body_close %>
