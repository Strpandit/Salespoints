<%= mailer_banner(title: "Admin Login Notification", subtitle: "SalesPoints Admin System", badge: "Security Alert", theme: :info) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">
    Hello <%= @admin.full_name %>,
  </p>

  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    Your SalesPoints Admin account was successfully logged in. Here are the details:
  </p>

  <%= mailer_info_table([
    ["Login Time", @login_time],
    ["Admin Email", @admin.email]
  ]) %>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #fffbeb; border-left: 4px solid #f59e0b; border-radius: 6px; margin: 20px 0;">
    <tr>
      <td style="padding: 14px 18px; font-size: 13px; color: #92400e; line-height: 1.7;">
        <strong>Security Tips</strong><br>
        &#10003; Always ensure you're on the secure admin portal<br>
        &#10003; Never share your credentials with anyone<br>
        &#10003; Log out when leaving your workstation<br>
        &#10003; Use strong passwords and enable 2FA
      </td>
    </tr>
  </table>

  <%= mailer_notice("If you didn't authorize this login, please contact the IT security team immediately.", theme: :danger, title: "Didn't recognize this login?") %>
<%= mailer_body_close %>
