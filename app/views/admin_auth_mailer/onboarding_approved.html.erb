<%= mailer_banner(title: "Admin Onboarding Approved", subtitle: "SalesPoints Admin System", badge: "✓ Approved", theme: :success) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">
    Hello <%= @admin.full_name %>,
  </p>

  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    Your SalesPoints admin onboarding has been approved. Your offer letter PDF is attached with this email.
  </p>

  <%= mailer_notice("Use the admin portal and the \"Forgot Password\" option to set your password before first login if you have not received credentials separately.".html_safe, theme: :success) %>

  <%= mailer_button(url: @login_url, text: "Go to Admin Portal", theme: :success) %>
<%= mailer_body_close %>
