<%= mailer_banner(title: "New Contact Form Submission", subtitle: "SalesPoints Support System", badge: "Action Required", theme: :info) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">
    Hello <%= @admin.first_name %>,
  </p>

  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    A new contact form submission has been received that requires your attention.
  </p>

  <p style="margin: 0 0 8px 0; font-size: 13px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px;">Submitter Information</p>
  <%= mailer_info_table([
    ["Name", @submission.name],
    ["Email", @submission.email],
    *(@submission.phone.present? ? [["Phone", @submission.phone]] : []),
    ["Subject", @submission.subject],
    ["Received", @submission.created_at.strftime("%B %d, %Y at %I:%M %p")]
  ]) %>

  <p style="margin: 0 0 8px 0; font-size: 13px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px;">Message</p>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f8fafc; border-left: 3px solid #1d4ed8; border-radius: 6px; margin: 0 0 20px 0;">
    <tr><td style="padding: 14px 18px; font-size: 14px; color: #334155; line-height: 1.6;"><%= simple_format(@submission.message) %></td></tr>
  </table>

  <p style="margin: 0; font-size: 13px; line-height: 1.6; color: #475569;">
    Please log into the admin panel to review and respond to this submission.<br><br>
    Thank you!<br>
    <strong style="color: #0f172a;">SalesPoints Support System</strong>
  </p>
<%= mailer_body_close %>
