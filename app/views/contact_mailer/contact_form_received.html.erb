<%= mailer_banner(title: "Message Received", subtitle: "SalesPoints Support", badge: "Confirmation", theme: :info) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">
    Hi <%= @submission.name %>,
  </p>

  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    Thank you for reaching out to us! We've received your message and appreciate you taking the time to contact SalesPoints.
  </p>

  <%= mailer_info_table([
    ["Subject", @submission.subject],
    ["Received", @submission.created_at.strftime("%B %d, %Y at %I:%M %p")]
  ]) %>

  <p style="margin: 0 0 8px 0; font-size: 15px; font-weight: 700; color: #0f172a;">What's next?</p>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 20px;">
    <tr><td style="padding: 4px 0; font-size: 13px; color: #334155;">&bull; Our team will review your message within 24 business hours</td></tr>
    <tr><td style="padding: 4px 0; font-size: 13px; color: #334155;">&bull; You'll receive a response at this email address</td></tr>
    <tr><td style="padding: 4px 0; font-size: 13px; color: #334155;">&bull; If your inquiry is urgent, we recommend calling us directly</td></tr>
  </table>

  <p style="margin: 0; font-size: 13px; line-height: 1.6; color: #475569;">
    Thank you for choosing SalesPoints!<br>
    <strong style="color: #0f172a;">SalesPoints Team</strong>
  </p>
<%= mailer_body_close %>
