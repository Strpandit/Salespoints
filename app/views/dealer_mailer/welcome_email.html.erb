<% dealer_first_name = @dealer.try(:first_name).presence || "Dealer" %>
<% dealer_full_name = @dealer.try(:full_name).presence || "#{dealer_first_name} #{@dealer.try(:last_name)}".strip %>
<% login_url = ENV['DEALER_LOGIN_URL'] || 'https://salespoints.in/dealer/login' %>
<%= mailer_banner(title: "Welcome to SalesPoints", subtitle: "Your Partner Account Credentials", badge: "Account Created", theme: :info) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">
    Hello <%= dealer_full_name %>,
  </p>

  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    Your SalesPoints dealer account has been set up. You can log in using the credentials below:
  </p>

  <%= mailer_info_table([
    ["Registered Email", @email],
    *(@password.present? ? [["Temporary Password", @password]] : [])
  ]) %>

  <%= mailer_button(url: login_url, text: "Log In to Dealer Portal →", theme: :info) %>

  <%= mailer_notice("We recommend changing your password immediately after your first login in your Profile Settings.".html_safe, theme: :warning, title: "Security Tip:") %>

  <p style="margin: 0; font-size: 13px; line-height: 1.6; color: #475569;">
    Best regards,<br>
    <strong style="color: #0f172a;">The SalesPoints Team</strong>
  </p>
<%= mailer_body_close %>
