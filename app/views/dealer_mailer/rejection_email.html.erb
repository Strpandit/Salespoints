<% dealer_first_name = @dealer.try(:first_name).presence || "Dealer" %>
<% dealer_full_name = @dealer.try(:full_name).presence || "#{dealer_first_name} #{@dealer.try(:last_name)}".strip %>
<%= mailer_banner(title: "Account Application Update", subtitle: "SalesPoints Dealer Onboarding", badge: "Application Status", theme: :danger) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">
    Hello <%= dealer_full_name %>,
  </p>

  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    Thank you for your interest in partnering with SalesPoints. After reviewing your dealer registration details, our verification team was unable to approve your application at this time.
  </p>

  <% if @reason.present? %>
    <%= mailer_notice(@reason, theme: :danger, title: "Reason / Feedback:") %>
  <% end %>

  <p style="margin: 0 0 16px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    If you believe this decision was made in error or if you can provide updated business documents, please contact our support team.
  </p>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; margin: 0 0 20px 0;">
    <tr>
      <td style="padding: 14px 18px; font-size: 13px; color: #475569; line-height: 1.5;">
        Need help or have questions? Email us at <a href="mailto:support@salespoints.in" style="color: #2563eb; font-weight: 600;">support@salespoints.in</a>.
      </td>
    </tr>
  </table>

  <p style="margin: 0; font-size: 13px; line-height: 1.6; color: #475569;">
    Sincerely,<br>
    <strong style="color: #0f172a;">SalesPoints Onboarding &amp; Compliance Team</strong>
  </p>
<%= mailer_body_close %>
