<% dealer_first_name = @dealer.try(:first_name).presence || "Dealer" %>
<% dealer_full_name = @dealer.try(:full_name).presence || "#{dealer_first_name} #{@dealer.try(:last_name)}".strip %>
<% login_url = ENV['DEALER_LOGIN_URL'] || 'https://salespoints.in/dealer/login' %>
<%= mailer_banner(title: "Welcome to SalesPoints", subtitle: "Your Dealer Account is Officially Active & Ready", badge: "✓ Account Approved", theme: :success) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    Hi <%= dealer_full_name %>,
  </p>

  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    Great news! Your SalesPoints dealer application has been reviewed and <strong style="color: #059669;">approved by our administration team</strong>. You now have full access to start selling, managing your catalog, and receiving orders.
  </p>

  <%= mailer_button(url: login_url, text: "Access Dealer Dashboard →", theme: :success) %>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; margin: 24px 0;">
    <tr>
      <td style="padding: 20px;">
        <p style="margin: 0 0 12px 0; font-size: 13px; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: 0.5px;">What You Can Do Now:</p>
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
          <tr><td style="padding: 6px 0; font-size: 14px; color: #1e293b; line-height: 1.5;"><span style="color: #059669; font-weight: bold; margin-right: 8px;">&bull;</span> List and manage your products and inventory</td></tr>
          <tr><td style="padding: 6px 0; font-size: 14px; color: #1e293b; line-height: 1.5;"><span style="color: #059669; font-weight: bold; margin-right: 8px;">&bull;</span> Receive B2B and retail orders with real-time updates</td></tr>
          <tr><td style="padding: 6px 0; font-size: 14px; color: #1e293b; line-height: 1.5;"><span style="color: #059669; font-weight: bold; margin-right: 8px;">&bull;</span> Track settlement cycles, earnings, and automated payouts</td></tr>
          <tr><td style="padding: 6px 0; font-size: 14px; color: #1e293b; line-height: 1.5;"><span style="color: #059669; font-weight: bold; margin-right: 8px;">&bull;</span> Manage store locations, delivery radius, and staff access</td></tr>
        </table>
      </td>
    </tr>
  </table>

  <p style="margin: 24px 0 12px 0; font-size: 15px; font-weight: 700; color: #0f172a;">Recommended Next Steps:</p>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 20px;">
    <tr>
      <td valign="top" width="28" style="padding: 6px 0; font-size: 13px; font-weight: 700; color: #059669;">1.</td>
      <td style="padding: 6px 0; font-size: 13px; color: #334155; line-height: 1.5;"><strong>Complete Profile Details:</strong> Ensure your GST, PAN, and bank details for settlements are accurate.</td>
    </tr>
    <tr>
      <td valign="top" width="28" style="padding: 6px 0; font-size: 13px; font-weight: 700; color: #059669;">2.</td>
      <td style="padding: 6px 0; font-size: 13px; color: #334155; line-height: 1.5;"><strong>Upload Products:</strong> Add your stock catalog with photos and competitive pricing.</td>
    </tr>
    <tr>
      <td valign="top" width="28" style="padding: 6px 0; font-size: 13px; font-weight: 700; color: #059669;">3.</td>
      <td style="padding: 6px 0; font-size: 13px; color: #334155; line-height: 1.5;"><strong>Set Service Radius:</strong> Configure delivery and store dispatch radiuses for local buyers.</td>
    </tr>
  </table>

  <%= mailer_notice("Keep an eye on your email inbox and WhatsApp for order notifications and inventory alerts.".html_safe, theme: :warning, title: "Pro Tip:") %>

  <p style="margin: 24px 0 16px 0; font-size: 13px; line-height: 1.6; color: #64748b;">
    Need help getting started? Our partner support team is here for you.<br>
    Reach us at <a href="mailto:support@salespoints.in" style="color: #059669; font-weight: 600; text-decoration: underline;">support@salespoints.in</a>.
  </p>

  <p style="margin: 0; font-size: 14px; font-weight: 600; color: #0f172a;">
    Welcome aboard,<br>
    <span style="color: #475569; font-weight: 500; font-size: 13px;">The SalesPoints Marketplace Team</span>
  </p>
<%= mailer_body_close %>
