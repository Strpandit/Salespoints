<%
  theme =
    case @return_request.status.to_s
    when "approved", "completed"
      :success
    when "rejected", "cancelled"
      :danger
    else
      :info
    end

  intro_text =
    case @recipient_role
    when "seller"
      "A buyer has submitted a replacement request for one of your orders. Please review the request details below."
    when "super_admin"
      @event_name == "created" ? "A new replacement request has been created on SalesPoints." : "A replacement request has been updated on SalesPoints."
    else
      @event_name == "created" ? "We have successfully logged your replacement request." : "There is a fresh update on your replacement request."
    end
%>
<%= mailer_banner(title: "Replacement Request #{@status_label}", subtitle: intro_text, badge: "SalesPoints Replacement Desk", theme: theme) %>
<%= mailer_body_open %>
  <%= mailer_info_table([
    ["Order Number", @order_reference],
    ["Request Type", @return_request.request_type.to_s.humanize],
    ["Current Status", @status_label],
    ["Seller", @seller&.dealer_code.presence || @seller&.email.presence || "N/A"],
    ["Submitted On", format_date(@return_request.created_at)]
  ]) %>

  <% if @changed_fields.present? %>
    <p style="margin: 24px 0 12px 0; font-size: 16px; font-weight: 700; color: #0f172a;">What Changed</p>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse: separate; border-spacing: 0 10px;">
      <% @changed_fields.each do |change| %>
        <tr>
          <td style="width: 34%; padding: 14px 16px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px 0 0 12px; font-size: 13px; font-weight: 700; color: #0f172a;">
            <%= change[:label] %>
          </td>
          <td style="width: 66%; padding: 14px 16px; background: #ffffff; border: 1px solid #e2e8f0; border-left: 0; border-radius: 0 12px 12px 0; font-size: 13px; color: #334155;">
            <% if change[:before].present? %>
              <div style="margin-bottom: 6px;"><span style="font-weight: 700; color: #64748b;">Previous:</span> <%= change[:before] %></div>
            <% end %>
            <div><span style="font-weight: 700; color: #0f172a;">Current:</span> <%= change[:after] %></div>
          </td>
        </tr>
      <% end %>
    </table>
  <% end %>

  <p style="margin: 24px 0 4px 0; font-size: 16px; font-weight: 700; color: #0f172a;">Request Details</p>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background: #fffdf7; border: 1px solid #fde68a; border-radius: 12px; margin: 12px 0 0;">
    <tr>
      <td style="padding: 16px 20px;">
        <p style="margin: 0 0 10px 0; font-size: 14px; line-height: 1.7; color: #334155;"><strong>Reason:</strong> <%= @return_request.reason.presence || "N/A" %></p>
        <p style="margin: 0; font-size: 14px; line-height: 1.7; color: #334155;"><strong>Details:</strong> <%= @return_request.details.presence || "N/A" %></p>
      </td>
    </tr>
  </table>

  <% if @return_request.resolution_notes.present? %>
    <p style="margin: 24px 0 4px 0; font-size: 16px; font-weight: 700; color: #0f172a;">Resolution Notes</p>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 12px; margin: 12px 0 0;">
      <tr><td style="padding: 16px 20px; font-size: 14px; line-height: 1.7; color: #334155;"><%= @return_request.resolution_notes %></td></tr>
    </table>
  <% end %>

  <%= mailer_notice("This is an automated update from SalesPoints. Please use the order management panel to review the latest request state and take any required next action.", theme: :info) %>
<%= mailer_body_close %>
