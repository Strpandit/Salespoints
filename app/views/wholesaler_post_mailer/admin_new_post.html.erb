<%= mailer_banner(title: "New Wholesaler Post Awaiting Approval", subtitle: "SalesPoints Admin Notification", badge: "Action Required", theme: :warning) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    A dealer has submitted a new wholesaler post. Please review it in the Admin Panel.
  </p>

  <p style="margin: 0 0 6px 0; font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px;">Submitted By</p>
  <%= mailer_actor_block(name: @dealer&.full_name, email: @dealer&.email, theme: :warning) %>

  <%= mailer_info_table([
    ["Post Title", @post.title],
    ["Price", @post.price.present? ? "₹#{@post.price.to_f.round(2)}" : "N/A"],
    ["Stock Quantity", @post.stock_quantity],
    ["Pincodes", @post.pincodes.is_a?(Array) ? @post.pincodes.join(", ") : (@post.pincodes.presence || "All")],
    ["Business Name", @dealer&.dealer_profile&.business_name],
    ["Submitted At", @post.created_at&.strftime("%d %B %Y, %I:%M %p") || "N/A"]
  ]) %>

  <% if @post.body.present? %>
    <p style="margin: 16px 0 4px 0; font-size: 14px; font-weight: 700; color: #0f172a;">Description</p>
    <p style="margin: 0 0 16px 0; font-size: 14px; color: #374151; line-height: 1.6;"><%= @post.body %></p>
  <% end %>

  <%= mailer_button(url: ENV['ADMIN_LOGIN_URL'] || 'https://salespoints.in/admin/login', text: "Review in Admin Panel", theme: :warning) %>
<%= mailer_body_close %>
