<%= mailer_banner(title: "Wholesaler Post Approved", subtitle: "SalesPoints Marketplace", badge: "✓ Approved", theme: :success) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">
    Hi <%= @dealer&.full_name.presence || "there" %>,
  </p>

  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    Great news! Your wholesaler post <strong>&ldquo;<%= @post.title %>&rdquo;</strong> has been approved and is now live on the Wholesaler Feed for matching dealers to see.
  </p>

  <%= mailer_info_table([
    ["Post Title", @post.title],
    ["Price", @post.price.present? ? "₹#{@post.price.to_f.round(2)}" : "N/A"],
    ["Stock Quantity", @post.stock_quantity],
    ["Live Until", @post.visible_until&.strftime("%d %B %Y, %I:%M %p") || "N/A"]
  ]) %>

  <%= mailer_notice("Your post stays live for 7 days. If it expires before you make a sale, you can re-upload it in one click from your Wholesaler Posts screen.", theme: :success) %>

  <%= mailer_button(url: "#{ENV['FRONTEND_URL'] || 'https://salespoints.in'}/dealer/wholesaler", text: "View Your Post", theme: :success) %>
<%= mailer_body_close %>
