<% time_label = @hours_before >= 24 ? "24 hours" : "1 hour" %>
<%= mailer_banner(title: "Your Post Is Expiring Soon", subtitle: "SalesPoints Marketplace", badge: "⏰ Expires in #{time_label}", theme: :warning) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">
    Hi <%= @dealer&.full_name.presence || "there" %>,
  </p>

  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    Your wholesaler post <strong>&ldquo;<%= @post.title %>&rdquo;</strong> will expire and disappear from the Wholesaler Feed in <strong><%= time_label %></strong>.
  </p>

  <%= mailer_info_table([
    ["Post Title", @post.title],
    ["Price", @post.price.present? ? "₹#{@post.price.to_f.round(2)}" : "N/A"],
    ["Expires On", @post.visible_until&.strftime("%d %B %Y, %I:%M %p") || "N/A"]
  ]) %>

  <%= mailer_notice("Once it expires, buyers will no longer see this post. Re-upload it in one click to keep it live for another 7 days — it will need a quick admin re-approval.".html_safe, theme: :warning, title: "Don't lose visibility:") %>

  <%= mailer_button(url: "#{ENV['FRONTEND_URL'] || 'https://salespoints.in'}/dealer/wholesaler", text: "Re-upload Now", theme: :warning) %>
<%= mailer_body_close %>
