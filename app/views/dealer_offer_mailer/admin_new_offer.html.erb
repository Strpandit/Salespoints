<%= mailer_banner(title: "New Offer Mart Deal Awaiting Approval", subtitle: "SalesPoints Admin Notification", badge: "Action Required", theme: :warning) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    A dealer has submitted a new Offer Mart deal. Please review and approve it in the Admin Panel.
  </p>

  <p style="margin: 0 0 6px 0; font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px;">Submitted By</p>
  <%= mailer_actor_block(name: @dealer&.full_name, email: @dealer&.email, theme: :warning) %>

  <%= mailer_info_table([
    ["Offer Title", @offer.display_title],
    ["Offer Price", @offer.offer_price.present? ? "₹#{@offer.offer_price.to_f.round(2)}" : "N/A"],
    ["Available Quantity", @offer.available_quantity],
    ["Pincodes", @offer.pincodes.is_a?(Array) ? @offer.pincodes.join(", ") : (@offer.pincodes.presence || "All")],
    ["Scheme Category", @offer.scheme_category&.titleize || "N/A"],
    ["Business Name", @dealer&.dealer_profile&.business_name],
    ["Submitted At", @offer.created_at&.strftime("%d %B %Y, %I:%M %p") || "N/A"]
  ]) %>

  <% if @offer.special_terms.present? %>
    <p style="margin: 16px 0 4px 0; font-size: 14px; font-weight: 700; color: #0f172a;">Special Terms</p>
    <p style="margin: 0 0 16px 0; font-size: 14px; color: #374151; line-height: 1.6;"><%= @offer.special_terms %></p>
  <% end %>

  <%= mailer_button(url: ENV['ADMIN_LOGIN_URL'] || 'https://salespoints.in/admin/login', text: "Review in Admin Panel", theme: :warning) %>
<%= mailer_body_close %>
