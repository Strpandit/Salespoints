<% time_label = @hours_before >= 24 ? "24 hours" : "1 hour" %>
<%= mailer_banner(title: "Your Offer Is Expiring Soon", subtitle: "SalesPoints Offer Mart", badge: "⏰ Expires in #{time_label}", theme: :warning) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">
    Hi <%= @dealer&.full_name.presence || "there" %>,
  </p>

  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    Your Offer Mart offer <strong>&ldquo;<%= @offer.display_title %>&rdquo;</strong> will expire and disappear from Offer Mart in <strong><%= time_label %></strong>.
  </p>

  <%= mailer_info_table([
    ["Offer", @offer.display_title],
    ["Offer Price", "₹#{@offer.offer_price.to_f.round(2)}"],
    ["Live Duration", @offer.live_duration_label],
    ["Expires On", @offer.visible_until&.strftime("%d %B %Y, %I:%M %p") || "N/A"]
  ]) %>

  <%= mailer_notice("Once it expires, customers will no longer see this offer. You can re-upload it from your Offers page and choose a new live duration (up to #{LiveDuration::MAX} days) — it will need a quick admin re-approval.".html_safe, theme: :warning, title: "Don't lose visibility:") %>

  <%= mailer_button(url: "#{ENV['FRONTEND_URL'] || 'https://salespoints.in'}/dealer/offers", text: "View My Offers", theme: :warning) %>
<%= mailer_body_close %>
