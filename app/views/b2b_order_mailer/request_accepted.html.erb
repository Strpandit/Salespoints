<% if @view_type == "buyer" %>
  <%= mailer_banner(title: "Request Accepted", subtitle: "Payment pending — complete your payment", badge: "SalesPoints B2B", theme: :warning) %>
  <%= mailer_body_open %>
    <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">Hello <%= @buyer&.full_name || @buyer&.dealer_code || 'Dealer' %>,</p>
    <p style="margin: 0 0 8px 0; font-size: 14px; line-height: 1.6; color: #334155;">Your B2B request <strong style="color: #0f766e;"><%= @order.reference_number %></strong> has been accepted by a seller.</p>
    <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;"><strong>Please complete your payment to confirm the order.</strong></p>

    <%= mailer_button(url: @payment_link, text: "Pay Now — ₹#{@order.total_amount.to_f.round(2)}", theme: :success) %>
    <p style="margin: -16px 0 20px; font-size: 12px; color: #94a3b8; text-align: center;">Payment link expires in 24 hours</p>

    <p style="margin: 0 0 12px 0; font-size: 14px; font-weight: 700; color: #0f766e;">Order Details</p>
    <% @order.b2b_order_items.each do |item| %>
      <%= mailer_order_item_row(name: item.product_variant&.product&.name || 'Product', quantity: item.quantity, price: "₹#{item.total_price.to_f.round(2)}") %>
    <% end %>

    <%= mailer_order_totals(total: "₹#{@order.total_amount.to_f.round(2)}") %>

    <%= mailer_notice("Complete payment within 24 hours to confirm your order.".html_safe, theme: :warning, title: "Action Required:") %>
  <%= mailer_body_close %>

<% elsif @view_type == "seller" %>
  <%= mailer_banner(title: "You Accepted This Request", subtitle: "Request ##{@order.reference_number}", badge: "SalesPoints B2B", theme: :success) %>
  <%= mailer_body_open %>
    <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">Hello <%= @seller&.full_name || @seller&.dealer_code || 'Seller' %>,</p>
    <p style="margin: 0 0 8px 0; font-size: 14px; line-height: 1.6; color: #334155;">You have accepted the B2B request <strong style="color: #0f766e;"><%= @order.reference_number %></strong>.</p>
    <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">Waiting for the buyer to complete the payment.</p>

    <p style="margin: 0 0 8px 0; font-size: 13px; font-weight: 700; color: #059669;">Buyer Information</p>
    <%= mailer_info_table([
      ["Dealer Code", @buyer&.dealer_code || 'N/A'],
      ["Phone", @buyer&.phone || 'N/A'],
      ["Address", @buyer&.dealer_profile&.business_address || 'N/A']
    ]) %>

    <p style="margin: 20px 0 12px 0; font-size: 13px; font-weight: 700; color: #059669;">Order Items</p>
    <% @order.b2b_order_items.each do |item| %>
      <%= mailer_order_item_row(name: item.product_variant&.product&.name || 'Product', quantity: item.quantity, price: "₹#{item.total_price.to_f.round(2)}") %>
    <% end %>

    <%= mailer_order_totals(total: "₹#{@order.total_amount.to_f.round(2)}") %>
    <p style="margin: 8px 0 20px; font-size: 13px; color: #94a3b8;">Payment Status: <%= mailer_badge("Pending", theme: :warning) %></p>

    <%= mailer_notice("Please prepare the order. You'll be notified once payment is confirmed.", theme: :success) %>
  <%= mailer_body_close %>

<% elsif @view_type == "admin" %>
  <%= mailer_banner(title: "Request Accepted", subtitle: "Request ##{@order.reference_number}", badge: "Admin Alert", theme: :info) %>
  <%= mailer_body_open %>
    <p style="margin: 0 0 6px 0; font-size: 13px; font-weight: 700; color: #0f766e;">Buyer</p>
    <p style="margin: 0 0 2px 0; font-size: 14px; color: #334155;"><%= @buyer&.full_name || @buyer&.dealer_code || 'N/A' %></p>
    <p style="margin: 0 0 16px 0; font-size: 13px; color: #64748b;"><%= @buyer&.email || 'N/A' %> | <%= @buyer&.phone || 'N/A' %> | Code: <%= @buyer&.dealer_code || 'N/A' %></p>

    <p style="margin: 0 0 6px 0; font-size: 13px; font-weight: 700; color: #059669;">Seller</p>
    <p style="margin: 0 0 2px 0; font-size: 14px; color: #334155;"><%= @seller&.full_name || @seller&.dealer_code || 'N/A' %></p>
    <p style="margin: 0 0 16px 0; font-size: 13px; color: #64748b;"><%= @seller&.email || 'N/A' %> | <%= @seller&.phone || 'N/A' %> | Code: <%= @seller&.dealer_code || 'N/A' %></p>

    <p style="margin: 0 0 12px 0; font-size: 14px; font-weight: 700; color: #0f766e;">Order Items</p>
    <% @order.b2b_order_items.each do |item| %>
      <%= mailer_order_item_row(name: item.product_variant&.product&.name || 'Product', quantity: item.quantity, price: "₹#{item.total_price.to_f.round(2)}") %>
    <% end %>

    <%= mailer_order_totals(
      rows: [["Subtotal", "₹#{@order.subtotal_amount.to_f.round(2)}"], ["Tax", "₹#{@order.tax_amount.to_f.round(2)}"]],
      total: "₹#{@order.total_amount.to_f.round(2)}"
    ) %>
    <p style="margin: 8px 0 0 0; font-size: 13px; color: #f59e0b; font-weight: 600;">Payment: Pending</p>
  <%= mailer_body_close %>
<% end %>
