<% if @view_type == "buyer" %>
  <%= mailer_banner(title: "Order Delivered", subtitle: "Order ##{@order.reference_number}", badge: "SalesPoints B2B", theme: :success) %>
  <%= mailer_body_open %>
    <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">Hello <%= @buyer&.full_name || @buyer&.dealer_code || 'Dealer' %>,</p>
    <p style="margin: 0 0 8px 0; font-size: 14px; line-height: 1.6; color: #334155;">Your order <strong style="color: #0f766e;"><%= @order.reference_number %></strong> has been <strong>delivered successfully</strong>.</p>
    <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">Please find the invoice attached to this email.</p>

    <%= mailer_info_table([
      ["Order Number", @order.reference_number],
      ["Total Amount", "₹#{@order.total_amount.to_f.round(2)}"],
      ["Status", "✅ Delivered"]
    ]) %>

    <%= mailer_notice("Thank you for doing business with SalesPoints!", theme: :success) %>
  <%= mailer_body_close %>

<% elsif @view_type == "seller" %>
  <%= mailer_banner(title: "Order Delivered", subtitle: "Order ##{@order.reference_number}", badge: "SalesPoints B2B", theme: :success) %>
  <%= mailer_body_open %>
    <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">Hello <%= @seller&.full_name || @seller&.dealer_code || 'Seller' %>,</p>
    <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">Order <strong style="color: #0f766e;"><%= @order.reference_number %></strong> has been delivered successfully.</p>

    <p style="margin: 0 0 8px 0; font-size: 13px; font-weight: 700; color: #059669;">Buyer Information</p>
    <%= mailer_info_table([
      ["Dealer Code", @buyer&.dealer_code || 'N/A'],
      ["Phone", @buyer&.phone || 'N/A']
    ]) %>

    <%= mailer_info_table([
      ["Order Number", @order.reference_number],
      ["Total", "₹#{@order.total_amount.to_f.round(2)}"]
    ]) %>
  <%= mailer_body_close %>

<% elsif @view_type == "admin" %>
  <%= mailer_banner(title: "Order Delivered", subtitle: "Order ##{@order.reference_number}", badge: "Admin Alert", theme: :success) %>
  <%= mailer_body_open %>
    <p style="margin: 0 0 6px 0; font-size: 13px; font-weight: 700; color: #0f766e;">Buyer</p>
    <p style="margin: 0 0 2px 0; font-size: 14px; color: #334155;"><%= @buyer&.full_name || @buyer&.dealer_code || 'N/A' %></p>
    <p style="margin: 0 0 16px 0; font-size: 13px; color: #64748b;"><%= @buyer&.email || 'N/A' %> | <%= @buyer&.phone || 'N/A' %></p>

    <p style="margin: 0 0 6px 0; font-size: 13px; font-weight: 700; color: #059669;">Seller</p>
    <p style="margin: 0 0 2px 0; font-size: 14px; color: #334155;"><%= @seller&.full_name || @seller&.dealer_code || 'N/A' %></p>
    <p style="margin: 0 0 16px 0; font-size: 13px; color: #64748b;"><%= @seller&.email || 'N/A' %> | <%= @seller&.phone || 'N/A' %></p>

    <p style="margin: 0 0 12px 0; font-size: 14px; font-weight: 700; color: #0f766e;">Order Items</p>
    <% @order.b2b_order_items.each do |item| %>
      <%= mailer_order_item_row(name: item.product_variant&.product&.name || 'Product', quantity: item.quantity, price: "₹#{item.total_price.to_f.round(2)}") %>
    <% end %>

    <%= mailer_order_totals(
      rows: [["Subtotal", "₹#{@order.subtotal_amount.to_f.round(2)}"], ["Tax", "₹#{@order.tax_amount.to_f.round(2)}"]],
      total: "₹#{@order.total_amount.to_f.round(2)}"
    ) %>
    <p style="margin: 8px 0 0 0; font-size: 13px; color: #15803d; font-weight: 600;">Payment: <%= payment_method_label(@order.payment_method) %> ✅</p>
  <%= mailer_body_close %>
<% end %>
