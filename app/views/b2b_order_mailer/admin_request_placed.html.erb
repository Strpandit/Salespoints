<%= mailer_banner(title: "New B2B Request", subtitle: "Request ##{@order.reference_number} — Placed on #{format_date(@order.created_at)}", badge: "SalesPoints B2B", theme: :info) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 8px 0; font-size: 14px; font-weight: 700; color: #0f766e;">Buyer Information</p>
  <%= mailer_info_table([
    ["Name", @buyer&.full_name || @buyer&.dealer_code || 'N/A'],
    ["Dealer Code", @buyer&.dealer_code || 'N/A'],
    ["Email", @buyer&.email || 'N/A'],
    ["Phone", @buyer&.phone || 'N/A'],
    ["Address", @buyer&.dealer_profile&.business_address || 'N/A']
  ]) %>

  <p style="margin: 20px 0 12px 0; font-size: 14px; font-weight: 700; color: #0f766e;">Request Items</p>
  <% @order.b2b_order_items.each do |item| %>
    <%= mailer_order_item_row(name: item.product_variant&.product&.name || 'Product', quantity: item.quantity, price: "₹#{item.total_price.to_f.round(2)}") %>
  <% end %>

  <%= mailer_order_totals(
    rows: [["Subtotal", "₹#{@order.subtotal_amount.to_f.round(2)}"], ["Tax", "₹#{@order.tax_amount.to_f.round(2)}"]],
    total: "₹#{@order.total_amount.to_f.round(2)}"
  ) %>
  <p style="margin: 8px 0 0 0; font-size: 13px; color: #64748b;">Status: <%= mailer_badge("Pending Acceptance", theme: :warning) %></p>
<%= mailer_body_close %>
