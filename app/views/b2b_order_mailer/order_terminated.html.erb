<% if @view_type == "buyer" %>
  <%= mailer_banner(title: "Request #{@reason}", subtitle: "Request ##{@order.reference_number}", badge: "SalesPoints B2B", theme: :danger) %>
  <%= mailer_body_open %>
    <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">Hello <%= @buyer&.full_name || @buyer&.dealer_code || 'Dealer' %>,</p>
    <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">Your B2B request <strong style="color: #dc2626;"><%= @order.reference_number %></strong> has been <strong><%= @reason.downcase %></strong>.</p>

    <%= mailer_info_table([
      ["Request Number", @order.reference_number],
      ["Total Amount", "₹#{@order.total_amount.to_f.round(2)}"],
      ["Status", @reason]
    ]) %>

    <%= mailer_notice("You can create a new request anytime from your SalesPoints dashboard.", theme: :warning) %>
  <%= mailer_body_close %>

<% elsif @view_type == "admin" %>
  <%= mailer_banner(title: "Request #{@reason}", subtitle: "Request ##{@order.reference_number}", badge: "Admin Alert", theme: :danger) %>
  <%= mailer_body_open %>
    <p style="margin: 0 0 6px 0; font-size: 13px; font-weight: 700; color: #dc2626;">Buyer</p>
    <p style="margin: 0 0 2px 0; font-size: 14px; color: #334155;"><%= @buyer&.full_name || @buyer&.dealer_code || 'N/A' %></p>
    <p style="margin: 0 0 16px 0; font-size: 13px; color: #64748b;"><%= @buyer&.email || 'N/A' %> | <%= @buyer&.phone || 'N/A' %></p>

    <p style="margin: 0 0 12px 0; font-size: 14px; font-weight: 700; color: #dc2626;">Order Items</p>
    <% @order.b2b_order_items.each do |item| %>
      <%= mailer_order_item_row(name: item.product_variant&.product&.name || 'Product', quantity: item.quantity, price: "₹#{item.total_price.to_f.round(2)}") %>
    <% end %>

    <%= mailer_order_totals(total: "₹#{@order.total_amount.to_f.round(2)}") %>
    <p style="margin: 8px 0 0 0; font-size: 13px; color: #dc2626; font-weight: 600;">Status: <%= @reason %></p>
  <%= mailer_body_close %>
<% end %>
