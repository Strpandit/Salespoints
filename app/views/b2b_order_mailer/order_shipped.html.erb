<%= mailer_banner(title: "Order Shipped", subtitle: "Order ##{@order.reference_number}", badge: "SalesPoints B2B", theme: :info) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">
    Hello <%= @buyer&.full_name || @buyer&.dealer_code || 'Dealer' %>,
  </p>
  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    Your order <strong style="color: #0f766e;"><%= @order.reference_number %></strong> has been <strong>shipped</strong> and is on its way.
  </p>

  <%= mailer_info_table([
    ["Order Number", @order.reference_number],
    ["Total Amount", "₹#{@order.total_amount.to_f.round(2)}"],
    ["Status", "🔄 In Transit"]
  ]) %>

  <p style="margin: 20px 0 12px 0; font-size: 14px; font-weight: 700; color: #0f766e;">Order Items</p>
  <% @order.b2b_order_items.each do |item| %>
    <%= mailer_order_item_row(name: item.product_variant&.product&.name || 'Product', quantity: item.quantity, price: "₹#{item.total_price.to_f.round(2)}") %>
  <% end %>

  <%= mailer_notice("You will receive a delivery confirmation once the order reaches its destination.", theme: :info) %>
<%= mailer_body_close %>
