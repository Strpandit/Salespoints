<%= mailer_banner(title: "Account Deleted", subtitle: "SalesPoints Admin Notification", badge: "⚠ Notice", theme: :danger) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    An account has been deleted from the system.
  </p>

  <%= mailer_info_table([
    ["Account Type", @account.class.name],
    ["Name", @account.full_name],
    ["Email", @account.email],
    ["Deleted By", @actor.full_name],
    ["Deleted At", Time.current.strftime("%d %B %Y %I:%M %p")]
  ]) %>

  <p style="margin: 0; font-size: 14px; line-height: 1.6; color: #334155;">
    This notification was sent to all Super Administrators.
  </p>
<%= mailer_body_close %>
