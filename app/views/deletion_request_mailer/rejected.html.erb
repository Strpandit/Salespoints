<%= mailer_banner(title: "Account Deletion Rejected", subtitle: "SalesPoints Account Management", badge: "✗ Rejected", theme: :warning) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    Your account deletion request has been reviewed.
  </p>

  <%= mailer_info_table([
    ["Status", "REJECTED"],
    ["Reason", @reason]
  ]) %>

  <p style="margin: 0; font-size: 14px; line-height: 1.6; color: #334155;">
    Your account remains active.
  </p>
<%= mailer_body_close %>
