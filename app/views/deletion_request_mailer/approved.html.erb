<%= mailer_banner(title: "Account Deletion Approved", subtitle: "SalesPoints Account Management", badge: "✓ Approved", theme: :success) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    Your account deletion request has been approved.
  </p>

  <%= mailer_info_table([
    ["Account", @account.full_name],
    ["Approved By", @approved_by.full_name],
    ["Status", "APPROVED"]
  ]) %>

  <p style="margin: 0; font-size: 14px; line-height: 1.6; color: #334155;">
    Your account has been successfully removed from SalesPoints.
  </p>
<%= mailer_body_close %>
