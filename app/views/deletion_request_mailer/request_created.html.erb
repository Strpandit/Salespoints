<%= mailer_banner(title: "Account Deletion Request", subtitle: "SalesPoints Admin Notification", badge: "Action Required", theme: :warning) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    A new account deletion request has been submitted.
  </p>

  <%= mailer_info_table([
    ["Account Type", @request.requestable_type],
    ["Name", @request.requestable.full_name],
    ["Email", @request.requestable.email],
    ["Reason", @request.reason.presence || "Not Provided"]
  ]) %>

  <p style="margin: 0; font-size: 14px; line-height: 1.6; color: #334155;">
    Please login and review this deletion request.
  </p>
<%= mailer_body_close %>
