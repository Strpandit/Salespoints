<%= mailer_banner(title: "New Order Placed", subtitle: "Order ##{@order.order_number}", badge: "Admin Alert", theme: :info) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 8px 0; font-size: 14px; font-weight: 700; color: #0f766e;">Buyer Information</p>
  <%= mailer_info_table([
    ["Name", @buyer&.full_name || 'N/A'],
    ["Email", @buyer&.email || 'N/A'],
    ["Phone", @buyer&.phone || 'N/A'],
    ["Address", @order.shipping_address.present? ? format_address(@order.shipping_address) : 'N/A']
  ]) %>

  <p style="margin: 20px 0 8px 0; font-size: 14px; font-weight: 700; color: #0f766e;">Seller Information</p>
  <%= mailer_info_table([
    ["Name", @seller&.full_name || @seller&.dealer_code || 'N/A'],
    ["Dealer Code", @seller&.dealer_code || 'N/A'],
    ["Email", @seller&.email || 'N/A'],
    ["Phone", @seller&.phone || 'N/A']
  ]) %>

  <p style="margin: 20px 0 12px 0; font-size: 14px; font-weight: 700; color: #0f766e;">Order Items</p>
  <% @order.order_items.each do |item| %>
    <%= mailer_order_item_row(name: item.product_variant&.product&.name || 'Product', quantity: item.quantity, price: "₹#{item.total_price.to_f.round(2)}") %>
  <% end %>

  <%= mailer_order_totals(
    rows: [["Subtotal", "₹#{@order.subtotal_amount.to_f.round(2)}"], ["Tax", "₹#{@order.tax_amount.to_f.round(2)}"]],
    total: "₹#{@order.total_amount.to_f.round(2)}"
  ) %>
  <p style="margin: 8px 0 0 0; font-size: 13px; color: #64748b;">Payment: <%= payment_method_label(@order.payment_method) %> — Status: <%= @order.payment_status.to_s.upcase %></p>
<%= mailer_body_close %>
