<% if @view_type == "buyer" %>
  <%= mailer_banner(title: "Order #{@reason}", subtitle: "Order ##{@order.order_number}", badge: "SalesPoints", theme: :danger) %>
  <%= mailer_body_open %>
    <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">Hello <%= @buyer&.full_name || 'Customer' %>,</p>
    <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">Your order <strong><%= @order.order_number %></strong> has been <strong><%= @reason.downcase %></strong>.</p>

    <%= mailer_info_table([
      ["Order Number", @order.order_number],
      ["Total", "₹#{@order.total_amount.to_f.round(2)}"]
    ]) %>

    <%= mailer_notice("If you have any questions, please contact our support team.", theme: :info) %>
  <%= mailer_body_close %>

<% elsif @view_type == "admin" %>
  <%= mailer_banner(title: "Order #{@reason}", subtitle: "Order ##{@order.order_number}", badge: "Admin Alert", theme: :danger) %>
  <%= mailer_body_open %>
    <p style="margin: 0 0 6px 0; font-size: 13px; font-weight: 700; color: #dc2626;">Buyer</p>
    <p style="margin: 0 0 16px 0; font-size: 14px; color: #334155;"><%= @buyer&.full_name || 'N/A' %> | <%= @buyer&.email || 'N/A' %> | <%= @buyer&.phone || 'N/A' %></p>

    <p style="margin: 0 0 12px 0; font-size: 14px; font-weight: 700; color: #dc2626;">Order Items</p>
    <% @order.order_items.each do |item| %>
      <%= mailer_order_item_row(name: item.product_variant&.product&.name || 'Product', quantity: item.quantity, price: "₹#{item.total_price.to_f.round(2)}") %>
    <% end %>

    <%= mailer_order_totals(total: "₹#{@order.total_amount.to_f.round(2)}") %>
  <%= mailer_body_close %>
<% end %>
