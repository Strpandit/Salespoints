<% if @view_type == "buyer" %>
  <%= mailer_banner(title: "Order Delivered", subtitle: "Order ##{@order.order_number}", badge: "SalesPoints", theme: :success) %>
  <%= mailer_body_open %>
    <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">Hello <%= @buyer&.full_name || 'Customer' %>,</p>
    <p style="margin: 0 0 8px 0; font-size: 14px; line-height: 1.6; color: #334155;">Your order <strong><%= @order.order_number %></strong> has been delivered successfully.</p>
    <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">Please find the invoice attached to this email.</p>

    <%= mailer_info_table([
      ["Order Number", @order.order_number],
      ["Total", "₹#{@order.total_amount.to_f.round(2)}"],
      ["Payment", payment_method_label(@order.payment_method)]
    ]) %>

    <%= mailer_notice("Thank you for choosing SalesPoints!", theme: :success) %>
  <%= mailer_body_close %>

<% elsif @view_type == "seller" %>
  <%= mailer_banner(title: "Order Delivered", subtitle: "Order ##{@order.order_number}", badge: "SalesPoints", theme: :success) %>
  <%= mailer_body_open %>
    <p style="margin: 0 0 8px 0; font-size: 14px; font-weight: 700; color: #0f766e;">Buyer Information</p>
    <%= mailer_info_table([
      ["Name", @buyer&.full_name || 'N/A'],
      ["Phone", @buyer&.phone || 'N/A'],
      ["Address", format_address(@order.shipping_address)]
    ]) %>

    <%= mailer_info_table([
      ["Order Number", @order.order_number],
      ["Total", "₹#{@order.total_amount.to_f.round(2)}"],
      ["Payment", payment_method_label(@order.payment_method)]
    ]) %>
  <%= mailer_body_close %>

<% elsif @view_type == "admin" %>
  <%= mailer_banner(title: "Order Delivered", subtitle: "Order ##{@order.order_number}", badge: "Admin Alert", theme: :success) %>
  <%= mailer_body_open %>
    <p style="margin: 0 0 6px 0; font-size: 13px; font-weight: 700; color: #0f766e;">Buyer</p>
    <p style="margin: 0 0 2px 0; font-size: 14px; color: #334155;"><%= @buyer&.full_name || 'N/A' %> | <%= @buyer&.email || 'N/A' %> | <%= @buyer&.phone || 'N/A' %></p>
    <p style="margin: 0 0 16px 0; font-size: 13px; color: #64748b;"><%= format_address(@order.shipping_address) %></p>

    <p style="margin: 0 0 6px 0; font-size: 13px; font-weight: 700; color: #0f766e;">Seller</p>
    <p style="margin: 0 0 16px 0; font-size: 14px; color: #334155;"><%= @seller&.full_name || @seller&.dealer_code || 'N/A' %> | <%= @seller&.email || 'N/A' %> | <%= @seller&.phone || 'N/A' %></p>

    <p style="margin: 0 0 12px 0; font-size: 14px; font-weight: 700; color: #0f766e;">Order Items</p>
    <% @order.order_items.each do |item| %>
      <%= mailer_order_item_row(name: item.product_variant&.product&.name || 'Product', quantity: item.quantity, price: "₹#{item.total_price.to_f.round(2)}") %>
    <% end %>

    <%= mailer_order_totals(
      rows: [["Subtotal", "₹#{@order.subtotal_amount.to_f.round(2)}"], ["Tax", "₹#{@order.tax_amount.to_f.round(2)}"]],
      total: "₹#{@order.total_amount.to_f.round(2)}"
    ) %>
    <p style="margin: 8px 0 0 0; font-size: 13px; color: #64748b;">Payment: <%= payment_method_label(@order.payment_method) %> | Status: <%= @order.payment_status.to_s.upcase %></p>
  <%= mailer_body_close %>
<% end %>
