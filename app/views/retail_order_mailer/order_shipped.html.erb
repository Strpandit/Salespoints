<%= mailer_banner(title: "Order Shipped", subtitle: "Order ##{@order.order_number}", badge: "SalesPoints", theme: :info) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">Hello <%= @buyer&.full_name || 'Customer' %>,</p>
  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">Your order <strong><%= @order.order_number %></strong> has been shipped and is on its way to you.</p>

  <p style="margin: 0 0 12px 0; font-size: 14px; font-weight: 700; color: #0f766e;">Order Summary</p>
  <% @order.order_items.each do |item| %>
    <%= mailer_order_item_row(name: item.product_variant&.product&.name || 'Product', quantity: item.quantity, price: "₹#{item.total_price.to_f.round(2)}") %>
  <% end %>

  <%= mailer_order_totals(total: "₹#{@order.total_amount.to_f.round(2)}") %>

  <%= mailer_notice("You will receive a confirmation once the order is delivered.", theme: :info) %>
<%= mailer_body_close %>
