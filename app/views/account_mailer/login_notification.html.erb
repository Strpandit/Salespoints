<%= mailer_banner(title: "Login Notification", subtitle: "SalesPoints Account Security", badge: "Security Alert", theme: :info) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">
    Hi <%= @account.first_name.presence || "there" %>,
  </p>

  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    Your SalesPoints account was successfully logged in. Here are the details:
  </p>

  <%= mailer_info_table([
    ["Login Time", @login_time],
    ["Account Email", @account.email]
  ]) %>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #fffbeb; border-left: 4px solid #f59e0b; border-radius: 6px; margin: 20px 0;">
    <tr>
      <td style="padding: 14px 18px; font-size: 13px; color: #92400e; line-height: 1.7;">
        <strong>Security Tips</strong><br>
        &#10003; Keep your password private and never share it with anyone<br>
        &#10003; Always use a strong, unique password<br>
        &#10003; Log out when using shared devices<br>
        &#10003; Be cautious of suspicious links or emails asking for your credentials
      </td>
    </tr>
  </table>

  <%= mailer_notice("If you didn't authorize this login, please <a href=\"#{ENV['FRONTEND_URL'] || 'https://salespoints.in/reset-password'}\" style=\"color: #991b1b; font-weight: 700;\">reset your password immediately</a>.".html_safe, theme: :danger, title: "Didn't recognize this login?") %>
<%= mailer_body_close %>
