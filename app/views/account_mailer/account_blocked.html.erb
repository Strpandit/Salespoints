<%= mailer_banner(title: "Account Blocked", subtitle: "SalesPoints Account Security", badge: "Action Required", theme: :danger) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">
    Hi <%= @account.first_name.presence || "there" %>,
  </p>

  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    We regret to inform you that your SalesPoints account has been temporarily blocked.
  </p>

  <%= mailer_info_table([
    ["Account Email", @account.email],
    ["Status", "Blocked"],
    ["Effective Date", Time.current.strftime("%B %d, %Y")]
  ]) %>

  <p style="margin: 0 0 8px 0; font-size: 14px; line-height: 1.6; color: #334155;">This action may have been taken due to:</p>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 20px;">
    <tr><td style="padding: 4px 0; font-size: 13px; color: #334155;">&bull; Violation of our terms and conditions</td></tr>
    <tr><td style="padding: 4px 0; font-size: 13px; color: #334155;">&bull; Suspicious account activity</td></tr>
    <tr><td style="padding: 4px 0; font-size: 13px; color: #334155;">&bull; Multiple failed security checks</td></tr>
  </table>

  <%= mailer_button(url: ENV['FRONTEND_URL'] || 'https://salespoints.in/contact', text: "Contact Support Team", theme: :danger) %>

  <p style="margin: 20px 0 0 0; font-size: 13px; line-height: 1.6; color: #475569;">
    If you believe this is an error, please reach out — we are here to help and will review your case promptly.
  </p>
<%= mailer_body_close %>
