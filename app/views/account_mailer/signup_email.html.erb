<%= mailer_banner(title: "Welcome to SalesPoints", subtitle: "Your Account Is Ready", badge: "Account Created", theme: :info) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">
    Hi <%= @account.first_name.presence || "there" %>,
  </p>

  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    Thank you for signing up with SalesPoints! We're excited to have you join our community of shoppers.
  </p>

  <%= mailer_info_table([["Email", @account.email], ["Status", "Active"]]) %>

  <p style="margin: 0 0 12px 0; font-size: 15px; font-weight: 700; color: #0f172a;">What's Next?</p>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 8px;">
    <tr>
      <td valign="top" width="28" style="padding: 6px 0; font-size: 13px; font-weight: 700; color: #1d4ed8;">1.</td>
      <td style="padding: 6px 0; font-size: 13px; color: #334155;">Complete your profile with additional information</td>
    </tr>
    <tr>
      <td valign="top" width="28" style="padding: 6px 0; font-size: 13px; font-weight: 700; color: #1d4ed8;">2.</td>
      <td style="padding: 6px 0; font-size: 13px; color: #334155;">Browse our amazing products and collections</td>
    </tr>
    <tr>
      <td valign="top" width="28" style="padding: 6px 0; font-size: 13px; font-weight: 700; color: #1d4ed8;">3.</td>
      <td style="padding: 6px 0; font-size: 13px; color: #334155;">Add items to your cart and check out</td>
    </tr>
    <tr>
      <td valign="top" width="28" style="padding: 6px 0; font-size: 13px; font-weight: 700; color: #1d4ed8;">4.</td>
      <td style="padding: 6px 0; font-size: 13px; color: #334155;">Complete your first purchase</td>
    </tr>
  </table>

  <%= mailer_button(url: ENV['FRONTEND_URL'] || 'https://salespoints.in', text: "Start Shopping Now", theme: :info) %>

  <p style="margin: 0; font-size: 13px; line-height: 1.6; color: #475569;">
    If you have any questions or need assistance, our support team is here to help.
  </p>
<%= mailer_body_close %>
