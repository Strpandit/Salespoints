<%= mailer_banner(title: "Account Deletion Confirmed", subtitle: "SalesPoints Account Security", badge: "Confirmation", theme: :neutral) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">Dear User,</p>

  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    This email confirms that your SalesPoints account has been permanently deleted.
  </p>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #fffbeb; border-left: 4px solid #f59e0b; border-radius: 6px; margin: 0 0 20px 0;">
    <tr>
      <td style="padding: 14px 18px; font-size: 13px; color: #92400e; line-height: 1.7;">
        <strong>Important Information:</strong><br>
        &bull; Your account data has been securely removed<br>
        &bull; You can create a new account anytime using this email<br>
        &bull; Any active orders will be cancelled<br>
        &bull; Wallet balance and loyalty points have been forfeited
      </td>
    </tr>
  </table>

  <p style="margin: 0 0 12px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    If you believe this deletion was made in error or need assistance, please contact our support team immediately.
  </p>

  <%= mailer_info_table([["Deletion Timestamp", Time.current.strftime("%B %d, %Y at %I:%M %p")]]) %>
<%= mailer_body_close %>
