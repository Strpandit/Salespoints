<%= mailer_banner(title: "Reset Your Password", subtitle: "SalesPoints Account", badge: "Action Required", theme: :info) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">
    Hello <%= @account.first_name.presence || 'User' %>,
  </p>

  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    We received a request to reset the password for your SalesPoints account. Click the button below to choose a new password.
    This link is valid for 30 minutes.
  </p>

  <%= mailer_button(url: @url, text: "Reset Password", theme: :info) %>

  <p style="margin: 0; font-size: 12px; line-height: 1.6; color: #94a3b8; word-break: break-all;">
    Or copy this link into your browser: <%= @url %>
  </p>

  <%= mailer_notice("If you didn't ask to reset your password, you can ignore this email — your password won't change.", theme: :info) %>
<%= mailer_body_close %>
