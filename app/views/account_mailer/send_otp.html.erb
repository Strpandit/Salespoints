<%= mailer_banner(title: "Your OTP Code", subtitle: "SalesPoints Account Verification", badge: "Verification", theme: :info) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">
    Hi <%= @account&.first_name.presence || 'User' %>,
  </p>

  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    We received a request to access your SalesPoints account. Use the OTP code below to verify your identity.
  </p>

  <%= mailer_otp_box(code: @otp, label: "Your One-Time Password", expires_in: "5 minutes", theme: :info) %>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #fffbeb; border-left: 4px solid #f59e0b; border-radius: 6px; margin: 20px 0;">
    <tr>
      <td style="padding: 14px 18px; font-size: 13px; color: #92400e; line-height: 1.7;">
        <strong>Security Tips</strong><br>
        &bull; <strong>Never share this code</strong> with anyone, not even SalesPoints staff<br>
        &bull; We will <strong>never ask you for this code</strong> via email, phone, or chat<br>
        &bull; If you didn't request this code, <strong>ignore this email</strong><br>
        &bull; Always verify you're on the official SalesPoints website
      </td>
    </tr>
  </table>

  <p style="margin: 0; font-size: 13px; line-height: 1.6; color: #475569;">
    Didn't request this OTP? If this wasn't you, your account credentials may be at risk. Please contact our support team immediately at <strong>support@salespoints.in</strong>.
  </p>
<%= mailer_body_close %>
