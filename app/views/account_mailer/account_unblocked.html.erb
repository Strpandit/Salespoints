<%= mailer_banner(title: "Account Reactivated", subtitle: "SalesPoints Account Security", badge: "✓ Active", theme: :success) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">
    Hi <%= @account.first_name.presence || "there" %>,
  </p>

  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    Great news! Your SalesPoints account has been successfully reactivated and is now ready to use.
  </p>

  <%= mailer_info_table([
    ["Account Email", @account.email],
    ["Status", "Active"],
    ["Reactivation Date", Time.current.strftime("%B %d, %Y")]
  ]) %>

  <p style="margin: 0 0 4px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    You can now access your account and enjoy all our amazing features and products.
  </p>

  <%= mailer_button(url: ENV['FRONTEND_URL'] || 'https://salespoints.in/', text: "Continue Shopping", theme: :success) %>

  <p style="margin: 0; font-size: 13px; line-height: 1.6; color: #475569;">
    Thank you for being part of the SalesPoints community!
  </p>
<%= mailer_body_close %>
