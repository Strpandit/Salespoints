<%= mailer_banner(title: "Delivery Verification Code", subtitle: "SalesPoints E-Commerce", badge: "OTP", theme: :info) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">
    Hello <%= @buyer_name %>,
  </p>

  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    Your order <strong><%= @order_ref %></strong> is out for delivery. Please share the OTP below with your delivery executive only after receiving and inspecting the package.
  </p>

  <%= mailer_otp_box(code: @otp, label: "Delivery Verification OTP", theme: :info) %>
  <p style="margin: -12px 0 20px; font-size: 13px; color: #64748b; text-align: center;">Share this code with the delivery person to confirm receipt.</p>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #fffbeb; border-left: 4px solid #f59e0b; border-radius: 6px; margin: 0;">
    <tr>
      <td style="padding: 14px 18px; font-size: 13px; color: #92400e; line-height: 1.7;">
        <strong>Important Instructions:</strong><br>
        &bull; Do not share this OTP before checking the physical condition of the package.<br>
        &bull; Once verified with this OTP, your order will be marked as successfully delivered.
      </td>
    </tr>
  </table>
<%= mailer_body_close %>
