<%= mailer_banner(title: "#{@entity_type} Deleted", subtitle: "SalesPoints Admin Notification", badge: "Record Removed", theme: :danger) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 8px 0;"><%= mailer_badge("#{@entity_type} — Removed", theme: :danger) %></p>

  <p style="margin: 12px 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    The <strong><%= @entity_type %></strong> record
    <strong>&ldquo;<%= @entity_name %>&rdquo;</strong>
    has been <strong>permanently deleted</strong> from the SalesPoints platform.
  </p>

  <p style="margin: 0 0 6px 0; font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px;">Deleted By</p>
  <%= mailer_actor_block(name: @actor[:name], email: @actor[:email], theme: :danger) %>

  <% if @details.present? %>
    <p style="margin: 0 0 8px 0; font-size: 14px; font-weight: 700; color: #0f172a;">Deleted Record — Last Known Values</p>
    <%= mailer_detail_grid(@details) %>
  <% end %>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; margin-top: 20px;">
    <tr>
      <td style="padding: 10px 16px; font-size: 12px; color: #64748b;">
        Deleted at: <%= Time.current.strftime("%d %b %Y, %I:%M %p %Z") %>
      </td>
    </tr>
  </table>

  <%= mailer_notice("This action is irreversible. All associated data may have been removed. If this deletion was unintended, contact your database administrator immediately.", theme: :danger, title: "Warning:") %>
<%= mailer_body_close %>
