<%= mailer_banner(title: "#{@entity_type} Record Updated", subtitle: "SalesPoints Admin Notification", badge: "#{@entity_type} — Modified", theme: :warning) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    The <strong><%= @entity_type %></strong> record
    <strong>&ldquo;<%= @entity_name %>&rdquo;</strong> has been updated. Details of the changes are listed below:
  </p>

  <% if @actor.present? && (@actor[:name].present? || @actor[:email].present?) %>
    <p style="margin: 0 0 6px 0; font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px;">Updated By</p>
    <%= mailer_actor_block(name: @actor[:name], email: @actor[:email], theme: :warning) %>
  <% end %>

  <% if @changes.present? %>
    <p style="margin: 0 0 8px 0; font-size: 14px; font-weight: 700; color: #0f172a;">Field Changes</p>
    <%= mailer_changes_table(@changes) %>
  <% end %>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; margin-top: 20px;">
    <tr>
      <td style="padding: 10px 16px; font-size: 12px; color: #64748b;">
        Updated at: <%= Time.current.strftime("%d %b %Y, %I:%M %p %Z") %>
      </td>
    </tr>
  </table>
<%= mailer_body_close %>
