<%
  action_themes = {
    "approved"    => :success,
    "rejected"    => :danger,
    "suspended"   => :warning,
    "activated"   => :success,
    "deactivated" => :danger,
    "updated"     => :warning,
  }
  theme = action_themes[@action.to_s.downcase] || :purple
%>
<%= mailer_banner(title: "Dealer Action: #{@action.to_s.titleize}", subtitle: "SalesPoints Admin Notification", badge: "Dealer Account", theme: theme) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 8px 0;"><%= mailer_badge(@action.to_s.upcase, theme: theme) %></p>

  <p style="margin: 12px 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    The dealer account <strong>&ldquo;<%= @dealer_name %>&rdquo;</strong>
    has had the action <strong><%= @action.to_s.titleize %></strong> performed on it.
  </p>

  <p style="margin: 0 0 6px 0; font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px;">Action Performed By</p>
  <%= mailer_actor_block(name: @actor[:name], email: @actor[:email], theme: theme) %>

  <%
    changes_is_diff = @changes.present? && @changes.values.all? { |v| v.is_a?(Hash) && (v.key?(:from) || v.key?("from") || v.key?(:to) || v.key?("to")) }
  %>
  <% if changes_is_diff %>
    <p style="margin: 0 0 8px 0; font-size: 14px; font-weight: 700; color: #0f172a;">What Changed</p>
    <%= mailer_changes_table(@changes) %>
  <% elsif @changes.present? %>
    <p style="margin: 0 0 8px 0; font-size: 14px; font-weight: 700; color: #0f172a;">Details</p>
    <%= mailer_detail_grid(@changes) %>
  <% end %>

  <% if @details.present? && @details.is_a?(Hash) %>
    <p style="margin: 16px 0 4px 0; font-size: 14px; font-weight: 700; color: #0f172a;">Additional Details</p>
    <%= mailer_detail_grid(@details) %>
  <% elsif @details.present? %>
    <p style="margin: 16px 0 4px 0; font-size: 14px; font-weight: 700; color: #0f172a;">Additional Notes</p>
    <p style="margin: 0; font-size: 14px; color: #374151; line-height: 1.6;"><%= @details %></p>
  <% end %>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; margin-top: 20px;">
    <tr>
      <td style="padding: 10px 16px; font-size: 12px; color: #64748b;">
        Action performed at: <%= Time.current.strftime("%d %b %Y, %I:%M %p %Z") %>
      </td>
    </tr>
  </table>
<%= mailer_body_close %>
