<%= mailer_banner(title: "Dealer Profile Updated — Status Pending", subtitle: "SalesPoints Admin Notification", badge: "⚠ Admin Re-Verification Required", theme: :warning) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 8px 0;"><%= mailer_badge("Account Status: PENDING", theme: :warning) %></p>

  <p style="margin: 12px 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    Dealer <strong><%= @dealer.full_name %></strong> (Business: <strong><%= @dealer.dealer_profile&.business_name || "N/A" %></strong>) has updated their profile/location information. As per safety policies, the dealer status has been updated to <strong>PENDING</strong> and requires Admin review and re-approval.
  </p>

  <p style="margin: 0 0 8px 0; font-size: 14px; font-weight: 700; color: #0f172a;">Dealer Overview</p>
  <%= mailer_info_table([
    ["Dealer Code", @dealer.dealer_code],
    ["Full Name", @dealer.full_name],
    ["Business Name", @dealer.dealer_profile&.business_name || "N/A"],
    ["Email / Phone", "#{@dealer.email} | #{@dealer.phone}"]
  ]) %>

  <% if @changes.present? %>
    <p style="margin: 0 0 8px 0; font-size: 14px; font-weight: 700; color: #0f172a;">Updated Fields (Diff)</p>
    <%= mailer_changes_table(@changes) %>
  <% end %>

  <%= mailer_notice("All products and wholesaler posts from this dealer are currently hidden from buyers. Once you verify these profile changes and click Approve in the Admin Dashboard, the dealer's account status will revert to ACTIVE and all live products will reappear automatically.".html_safe, theme: :info, title: "Note for Admin:") %>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; margin-top: 8px;">
    <tr>
      <td style="padding: 10px 16px; font-size: 12px; color: #64748b;">
        Requested at: <%= Time.current.strftime("%d %b %Y, %I:%M %p %Z") %>
      </td>
    </tr>
  </table>
<%= mailer_body_close %>
