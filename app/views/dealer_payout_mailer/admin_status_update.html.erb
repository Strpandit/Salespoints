<%= mailer_banner(title: "Payout Status Changed", subtitle: "Dealer payout request status has been updated.", badge: "SalesPoints Admin Finance", theme: :info) %>
<%= mailer_body_open %>
  <%= mailer_info_table([
    ["Dealer", @payout.dealer.full_name.presence || @payout.dealer.dealer_code],
    ["Request Number", @payout.request_number],
    ["Status", @payout.status.to_s.humanize],
    ["Payment Reference", @payout.payment_reference.presence || "Pending"],
    ["Admin Note", @payout.admin_note.presence || "N/A"]
  ]) %>
<%= mailer_body_close %>
