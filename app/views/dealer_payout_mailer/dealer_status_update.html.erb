<%= mailer_banner(title: "Payout Request Updated", subtitle: "Your payout request has a new status update.", badge: "SalesPoints Payout Desk", theme: :info) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 12px 0; font-size: 15px; color: #334155;">Hello <strong><%= @payout.dealer.full_name.presence || "Dealer" %></strong>,</p>
  <p style="margin: 0 0 18px 0; font-size: 15px; line-height: 1.8; color: #334155;">Request <strong><%= @payout.request_number %></strong> is now <strong><%= @payout.status.to_s.humanize %></strong>.</p>

  <%= mailer_info_table([
    ["Amount", "₹#{format_amount(@payout.amount)}"],
    ["Payment Reference", @payout.payment_reference.presence || "Pending"],
    ["Admin Note", @payout.admin_note.presence || "N/A"]
  ]) %>
<%= mailer_body_close %>
