<%= mailer_banner(title: "New Payout Request", subtitle: "A dealer has submitted a payout request. Full breakdown and GST invoice are attached for review.", badge: "SalesPoints Admin Finance", theme: :info) %>
<%= mailer_body_open %>
  <%= mailer_info_table([
    ["Dealer Name", "#{@payout.dealer.full_name.presence || @payout.dealer.dealer_code} (#{@payout.dealer.dealer_code})"],
    ["Request Number", @payout.request_number],
    ["Total Payout Amount", "₹#{format_amount(@payout.amount)}"],
    ["GST Invoice Number", @payout.invoice_number.presence || "N/A"],
    ["Bank Details", "#{@payout.bank_name} | A/C: #{@payout.bank_account_number} | IFSC: #{@payout.ifsc_code}"]
  ]) %>

  <% selected_orders = Array(@payout.metadata&.dig("selected_orders")) %>
  <% if selected_orders.any? %>
    <p style="margin: 20px 0 10px 0; font-size: 15px; font-weight: 700; color: #0f172a;">Requested Orders Breakdown (<%= selected_orders.length %> Orders)</p>
    <table width="100%" cellpadding="8" cellspacing="0" style="border-collapse: collapse; font-size: 13px; border: 1px solid #e2e8f0; border-radius: 8px; margin-bottom: 20px;">
      <thead>
        <tr style="background: #f1f5f9; color: #334155; text-align: left;">
          <th style="padding: 10px; border-bottom: 1px solid #e2e8f0;">Order Ref</th>
          <th style="padding: 10px; border-bottom: 1px solid #e2e8f0;">Type</th>
          <th style="padding: 10px; border-bottom: 1px solid #e2e8f0;">Buyer</th>
          <th style="padding: 10px; border-bottom: 1px solid #e2e8f0; text-align: right;">Amount</th>
        </tr>
      </thead>
      <tbody>
        <% selected_orders.each do |ord| %>
          <tr>
            <td style="padding: 10px; border-bottom: 1px solid #f1f5f9; font-weight: 600;"><%= ord["reference_number"] %></td>
            <td style="padding: 10px; border-bottom: 1px solid #f1f5f9; text-transform: uppercase;"><%= ord["flow_type"] %></td>
            <td style="padding: 10px; border-bottom: 1px solid #f1f5f9;"><%= ord["buyer_name"] %></td>
            <td style="padding: 10px; border-bottom: 1px solid #f1f5f9; text-align: right; font-weight: 700; color: #059669;">₹<%= format_amount(ord["amount"]) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <% if @payout.admin_note.present? %>
    <%= mailer_notice(@payout.admin_note, theme: :warning, title: "Dealer Note:") %>
  <% end %>
<%= mailer_body_close %>
