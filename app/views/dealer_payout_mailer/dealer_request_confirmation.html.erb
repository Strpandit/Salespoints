<%= mailer_banner(title: "Payout Request Submitted", subtitle: "Your payout request has been logged successfully. Our admin team will review the request and process the transfer through Cashfree.", badge: "SalesPoints Payout Desk", theme: :success) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 18px 0; font-size: 15px; color: #334155;">Hello <strong><%= @payout.dealer.full_name.presence || "Dealer" %></strong>,</p>

  <%= mailer_info_table([
    ["Request Number", @payout.request_number],
    ["Amount", "₹#{format_amount(@payout.amount)}"],
    ["Status", @payout.status.to_s.humanize],
    ["Order Reference", @payout.order_reference.presence || "N/A"],
    ["Invoice Number", @payout.invoice_number.presence || "N/A"]
  ]) %>

  <%= mailer_notice("Your GST invoice has been attached with this email for reference.", theme: :info) %>
<%= mailer_body_close %>
