<%= mailer_banner(title: "Payout Disbursed Successfully", subtitle: "Your payout has been transferred to your bank account.", badge: "✓ Disbursed", theme: :success) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 18px 0; font-size: 15px; color: #334155;">Dear <%= @dealer.full_name.presence || @dealer.email %>,</p>

  <p style="margin: 0 0 18px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    Great news! Your payout request <strong><%= @payout.request_number %></strong> has been successfully processed and transferred to your bank account.
  </p>

  <p style="margin: 0 0 8px 0; font-size: 14px; font-weight: 700; color: #0f172a;">Disbursement Summary</p>
  <%= mailer_info_table([
    ["Request Number", @payout.request_number],
    ["Disbursed Amount", "₹#{sprintf("%.2f", @payout.amount)}"],
    ["Bank UTR / Reference", @payout.payment_reference],
    ["Payment Mode", @payout.payment_mode.presence || 'Cashfree Payout / Bank Transfer'],
    ["Bank Name", @payout.bank_name],
    ["Account Number", "XXXXXX#{@payout.bank_account_number.to_s.last(4)}"],
    ["IFSC Code", @payout.ifsc_code],
    ["Date", (@payout.paid_at || Time.current).strftime("%d %b %Y, %I:%M %p")]
  ]) %>

  <p style="margin: 0; font-size: 13px; line-height: 1.6; color: #475569;">
    Thank you for doing business on SalesPoints Marketplace!<br>
    Best Regards,<br>
    <strong style="color: #0f172a;">SalesPoints India Pvt. Ltd.</strong>
  </p>
<%= mailer_body_close %>
