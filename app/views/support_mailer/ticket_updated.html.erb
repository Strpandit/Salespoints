<%= mailer_banner(title: "Support Ticket Updated", subtitle: "SalesPoints Support Team", badge: "Update", theme: :warning) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">
    Hi <%= @requester_name %>,
  </p>

  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    Your support ticket has been updated. Please review the changes below.
  </p>

  <%= mailer_info_table([
    ["Ticket Number", @ticket.ticket_number],
    ["Subject", @ticket.subject],
    ["Current Status", @ticket.status.humanize],
    ["Priority", @ticket.priority.upcase]
  ]) %>

  <p style="margin: 0; font-size: 13px; line-height: 1.6; color: #475569;">
    For more details, please log into your account and view your ticket.<br><br>
    Thank you for your patience!<br>
    <strong style="color: #0f172a;">SalesPoints Support Team</strong>
  </p>
<%= mailer_body_close %>
