<%= mailer_banner(title: "New Message on Your Ticket", subtitle: "SalesPoints Support Team", badge: "Ticket ##{@ticket.ticket_number}", theme: :info) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">
    Hi <%= @requester_name %>,
  </p>

  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    There's a new response on your support ticket. Here's the latest update:
  </p>

  <%= mailer_info_table([["Ticket Number", @ticket.ticket_number], ["Subject", @ticket.subject]]) %>

  <p style="margin: 0 0 8px 0; font-size: 13px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px;">Latest Message from <%= @message.sender_name %></p>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f8fafc; border-left: 3px solid #1d4ed8; border-radius: 6px; margin: 0 0 20px 0;">
    <tr><td style="padding: 14px 18px; font-size: 14px; color: #334155; line-height: 1.6;"><%= simple_format(@message.message) %></td></tr>
  </table>

  <%= mailer_button(url: "#{ENV['FRONTEND_URL']}/support/tickets/#{@ticket.ticket_number}", text: "View Full Conversation", theme: :info) %>

  <p style="margin: 0 0 20px 0; font-size: 14px; color: #334155;">Current Status: <strong><%= @ticket.status.humanize %></strong></p>

  <p style="margin: 0; font-size: 13px; line-height: 1.6; color: #475569;">
    If you have any additional information to add, please reply to this email or log in to your account.<br><br>
    Thank you for using SalesPoints!<br>
    <strong style="color: #0f172a;">SalesPoints Support Team</strong>
  </p>
  <p style="margin: 16px 0 0 0; font-size: 11px; color: #94a3b8;">Ticket ID: <%= @ticket.id %></p>
<%= mailer_body_close %>
