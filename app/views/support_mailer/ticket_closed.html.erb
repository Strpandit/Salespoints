<%= mailer_banner(title: "Support Ticket Closed", subtitle: "SalesPoints Support Team", badge: "Closed", theme: :neutral) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">
    Hi <%= @requester_name %>,
  </p>

  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    Your support ticket has been closed. If you need to reopen it or have any follow-up questions, please don't hesitate to contact us.
  </p>

  <%= mailer_info_table([
    ["Ticket Number", @ticket.ticket_number],
    ["Subject", @ticket.subject],
    ["Closed At", @ticket.updated_at.strftime("%B %d, %Y at %I:%M %p")]
  ]) %>

  <p style="margin: 0 0 8px 0; font-size: 15px; font-weight: 700; color: #0f172a;">How can we improve?</p>
  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    We'd love to hear your feedback about your support experience. If you have a few minutes, please reply to this email with any suggestions or comments.
  </p>

  <p style="margin: 0; font-size: 13px; line-height: 1.6; color: #475569;">
    Thank you for choosing SalesPoints!<br>
    <strong style="color: #0f172a;">SalesPoints Support Team</strong>
  </p>
<%= mailer_body_close %>
