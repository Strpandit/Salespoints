<%
  priority_themes = { "urgent" => :danger, "high" => :warning, "medium" => :warning, "low" => :success }
  priority_theme = priority_themes[@ticket.priority.to_s.downcase] || :info
%>
<%= mailer_banner(title: "Support Ticket Created", subtitle: "SalesPoints Support Team", badge: "Ticket ##{@ticket.ticket_number}", theme: :info) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">
    Hi <%= @requester_name %>,
  </p>

  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    Thank you for contacting our support team. We've received your support ticket and our team is already looking into it.
  </p>

  <%= mailer_info_table([["Ticket Number", @ticket.ticket_number], ["Subject", @ticket.subject], ["Category", @ticket.category_display]]) %>

  <p style="margin: -8px 0 20px 0;">
    <%= mailer_badge(@ticket.priority.upcase, theme: priority_theme) %>
    <%= mailer_badge(@ticket.status.upcase, theme: :info) %>
  </p>

  <p style="margin: 0 0 8px 0; font-size: 13px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px;">Your Message</p>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f8fafc; border-left: 3px solid #1d4ed8; border-radius: 6px; margin: 0 0 20px 0;">
    <tr><td style="padding: 14px 18px; font-size: 14px; color: #334155; line-height: 1.6;"><%= simple_format(@ticket.description) %></td></tr>
  </table>

  <p style="margin: 0 0 8px 0; font-size: 15px; font-weight: 700; color: #0f172a;">What happens next?</p>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 8px;">
    <tr><td style="padding: 4px 0; font-size: 13px; color: #334155;">&bull; Our support team will review your ticket within 24 hours</td></tr>
    <tr><td style="padding: 4px 0; font-size: 13px; color: #334155;">&bull; You'll receive email updates whenever there's activity on your ticket</td></tr>
    <tr><td style="padding: 4px 0; font-size: 13px; color: #334155;">&bull; You can check the status anytime using your ticket number</td></tr>
  </table>

  <%= mailer_button(url: "#{ENV['FRONTEND_URL']}/support/tickets/#{@ticket.ticket_number}", text: "View Your Ticket", theme: :info) %>

  <p style="margin: 0; font-size: 13px; line-height: 1.6; color: #475569;">
    If you have any questions in the meantime, feel free to reply to this email or contact us at support@salespoints.in.<br><br>
    Thank you for choosing SalesPoints!<br>
    <strong style="color: #0f172a;">SalesPoints Support Team</strong>
  </p>
  <p style="margin: 16px 0 0 0; font-size: 11px; color: #94a3b8;">Ticket ID: <%= @ticket.id %></p>
<%= mailer_body_close %>
