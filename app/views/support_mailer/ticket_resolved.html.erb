<%= mailer_banner(title: "Ticket Resolved", subtitle: "SalesPoints Support Team", badge: "✓ Resolved", theme: :success) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">
    Hi <%= @requester_name %>,
  </p>

  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    Great news! Your support ticket has been resolved by our support team.
  </p>

  <%= mailer_info_table([
    ["Ticket Number", @ticket.ticket_number],
    ["Subject", @ticket.subject],
    ["Resolved At", @ticket.resolved_at.strftime("%B %d, %Y at %I:%M %p")]
  ]) %>

  <p style="margin: 0 0 8px 0; font-size: 13px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px;">Resolution Summary</p>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #ecfdf5; border-left: 3px solid #10b981; border-radius: 6px; margin: 0 0 20px 0;">
    <tr><td style="padding: 14px 18px; font-size: 14px; color: #065f46; line-height: 1.6;"><%= simple_format(@ticket.resolution_summary) %></td></tr>
  </table>

  <%= mailer_button(url: "#{ENV['FRONTEND_URL']}/support/tickets/#{@ticket.ticket_number}", text: "View Complete Ticket", theme: :success) %>

  <p style="margin: 0 0 8px 0; font-size: 15px; font-weight: 700; color: #0f172a;">Next Steps</p>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 20px;">
    <tr><td style="padding: 4px 0; font-size: 13px; color: #334155;">&bull; The ticket will automatically close in 7 days</td></tr>
    <tr><td style="padding: 4px 0; font-size: 13px; color: #334155;">&bull; If the issue recurs, you can reopen it anytime</td></tr>
    <tr><td style="padding: 4px 0; font-size: 13px; color: #334155;">&bull; Please provide feedback on your support experience</td></tr>
  </table>

  <p style="margin: 0; font-size: 13px; line-height: 1.6; color: #475569;">
    We appreciate your patience and would love to hear your feedback. Thank you for using SalesPoints!<br>
    <strong style="color: #0f172a;">SalesPoints Support Team</strong>
  </p>
  <p style="margin: 16px 0 0 0; font-size: 11px; color: #94a3b8;">Ticket ID: <%= @ticket.id %></p>
<%= mailer_body_close %>
