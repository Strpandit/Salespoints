<%= mailer_banner(title: "Repeated Failed Logins", subtitle: "SalesPoints Admin Security", badge: "🚨 Security Alert", theme: :danger) %>
<%= mailer_body_open %>
  <p style="margin: 0 0 16px 0; font-size: 16px; font-weight: 600; color: #0f172a;">
    Hello <%= @recipient.full_name.presence || "Super Admin" %>,
  </p>

  <p style="margin: 0 0 20px 0; font-size: 14px; line-height: 1.6; color: #334155;">
    We detected <strong><%= @attempts %> failed login attempts</strong> on an admin account within the last <%= @window %>.
    Someone may be trying to guess this account's password or OTP.
  </p>

  <%= mailer_info_table([
    ["Admin Account", @admin.full_name.presence || "—"],
    ["Email", @admin.email],
    ["Failed Attempts", @attempts],
    ["IP Address(es)", @ip_addresses.presence&.join(", ") || "Unknown"],
    ["Detected At", Time.current.strftime("%d %B %Y, %I:%M %p")]
  ]) %>

  <%= mailer_notice("If this wasn't the account owner, reset the account password or deactivate the account from the Staff page, and review the Activity Logs.", theme: :danger, title: "Recommended action:") %>

  <%= mailer_button(url: "#{ENV['FRONTEND_URL'] || 'https://salespoints.in'}/admin/activity-logs", text: "Open Activity Logs", theme: :danger) %>
<%= mailer_body_close %>
